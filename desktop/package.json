{
  "name": "@siilvana/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "tauri dev",
    "dev:web": "vite",
    "icons": "tauri icon src-tauri/app-icon.svg --output src-tauri/icons",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e:scenario": "node e2e/scenario.mjs",
    "test:e2e:installation": "node e2e/installation.mjs",
    "test:e2e:installation-locations": "node e2e/installation-locations.mjs",
    "test:e2e:environment": "node e2e/environment.mjs",
    "test:e2e:scan-consent": "node e2e/scan-consent.mjs",
    "test:e2e:showroom": "node e2e/showroom.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@siilvana/api-client": "workspace:*",
    "@siilvana/catalog": "workspace:*",
    "@siilvana/shared": "workspace:*",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-store": "^2.4.0",
    "lucide-vue-next": "^0.542.0",
    "pinia": "^3.0.3",
    "three": "^0.185.1",
    "vue": "^3.5.21",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.8.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "15.11.7",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  }
}
