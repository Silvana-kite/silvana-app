{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siilvana",
  "version": "0.1.0",
  "identifier": "app.siilvana.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Siilvana", "width": 1280, "height": 820, "minWidth": 760, "minHeight": 600, "theme": "Light" }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https: http://localhost:*; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
