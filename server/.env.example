DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
# For Neon migration connection timeouts on TCP 5432:
# pnpm --filter @siilvana/server db:migrate --neon
CRON_SECRET=replace-with-at-least-32-random-bytes
DESKTOP_ORIGIN=tauri://localhost,http://tauri.localhost,http://localhost:1420
# Optional: increases the GitHub API rate limit. Never expose this to Vite/browser code.
GITHUB_TOKEN=
# If official sources require a proxy, configure the Node process environment:
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890

# Signed history publication (never use the integration test database)
HISTORY_DATASET_ID=siilvana-production
HISTORY_SIGNING_KEY_ID=production-1
HISTORY_SIGNING_KEY=
# Local development may use an absolute key file path instead.
HISTORY_SIGNING_KEY_FILE=
OPS_READ_TOKEN=
OPS_ALERT_WEBHOOK=
OPS_WEBHOOK_TOKEN=
